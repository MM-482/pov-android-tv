<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pov_controller_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/pov_bottom_scrim" android:tag="pov_unified_controls"
        android:layout_width="match_parent" android:layout_height="124dp" android:layout_gravity="bottom"
        android:orientation="vertical" android:paddingStart="30dp" android:paddingEnd="30dp"
        android:paddingTop="14dp" android:paddingBottom="14dp" android:background="@drawable/pov_player_scrim">
        <LinearLayout android:layout_width="match_parent" android:layout_height="22dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/pov_playback_title" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Now playing" android:textColor="#ECEFF3" android:textSize="16sp"
                android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:id="@+id/pov_buffering_status" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="gone" android:layout_marginStart="14dp">
                <ProgressBar android:id="@+id/pov_loading_spinner" style="?android:attr/progressBarStyleSmall"
                    android:layout_width="14dp" android:layout_height="14dp" android:indeterminate="true" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="7dp" android:text="Loading…" android:textSize="11sp" android:textColor="#CAD4E0" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@id/exo_position" android:layout_width="50dp" android:layout_height="wrap_content"
                android:text="0:00" android:textSize="11sp" android:textColor="#CED7E1" android:fontFamily="sans-serif-medium" />
            <androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress"
                android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1"
                android:focusable="true" android:contentDescription="Video timeline"
                android:nextFocusDown="@id/exo_play_pause"
                app:bar_height="2dp" app:touch_target_height="28dp" app:scrubber_enabled_size="6dp"
                app:scrubber_dragged_size="10dp" app:played_color="#00D5ED" app:scrubber_color="#FFFFFF"
                app:buffered_color="#718091" app:unplayed_color="#4DFFFFFF" />
            <TextView android:id="@id/exo_duration" android:layout_width="50dp" android:layout_height="wrap_content"
                android:gravity="end" android:text="0:00" android:textSize="11sp" android:textColor="#A6B6C8" />
        </LinearLayout>
        <LinearLayout android:id="@+id/pov_player_actions" android:layout_width="match_parent"
            android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@id/exo_rew" android:layout_width="40dp" android:layout_height="40dp"
                android:contentDescription="Back 10 seconds" android:padding="10dp"
                android:background="@drawable/pov_player_button" android:focusable="true" android:layout_marginEnd="4dp"
                android:nextFocusUp="@id/exo_progress" />
            <ImageButton android:id="@id/exo_play_pause" android:layout_width="44dp" android:layout_height="44dp"
                android:contentDescription="Play or pause" android:padding="12dp"
                android:background="@drawable/pov_player_button" android:focusable="true" android:layout_marginEnd="4dp"
                android:nextFocusUp="@id/exo_progress" />
            <ImageButton android:id="@+id/pov_stop" android:layout_width="40dp" android:layout_height="40dp"
                android:contentDescription="Stop playback" android:padding="10dp" android:src="@drawable/pov_ic_stop"
                android:background="@drawable/pov_player_button" android:focusable="true" android:layout_marginEnd="4dp"
                android:nextFocusUp="@id/exo_progress" />
            <ImageButton android:id="@id/exo_ffwd" android:layout_width="40dp" android:layout_height="40dp"
                android:contentDescription="Forward 10 seconds" android:padding="10dp"
                android:background="@drawable/pov_player_button" android:focusable="true" android:layout_marginEnd="10dp"
                android:nextFocusUp="@id/exo_progress" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <Button android:id="@+id/pov_audio" style="@style/POVPlayerAction" android:text="Audio"
                android:drawableStart="@drawable/pov_ic_audio" android:nextFocusUp="@id/exo_progress" />
            <Button android:id="@+id/pov_subtitles" style="@style/POVPlayerAction" android:text="Subtitles"
                android:drawableStart="@drawable/pov_ic_subtitles" android:nextFocusUp="@id/exo_progress" />
            <Button android:id="@+id/pov_boost" style="@style/POVPlayerAction" android:text="Boost · Off"
                android:drawableStart="@drawable/pov_ic_boost" android:nextFocusUp="@id/exo_progress" />
            <Button android:id="@+id/pov_browse" style="@style/POVPlayerAction" android:text="Browse"
                android:drawableStart="@drawable/pov_ic_browse" android:nextFocusUp="@id/exo_progress" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

